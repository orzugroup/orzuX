{
  "name": "orzuai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "dev:admin": "npm run dev --workspace=@orzu/admin",
    "build": "next build",
    "build:admin": "npm run build --workspace=@orzu/admin",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:secrets": "tsx --env-file=.env.local scripts/migrate-vercel-secrets.ts",
    "cleanup:secrets": "tsx --env-file=.env.local scripts/cleanup-invalid-app-secrets.ts",
    "rotate:secrets": "tsx --env-file=.env.local scripts/rotate-secrets.ts",
    "validate:env": "tsx --env-file=.env.local scripts/validate-env.ts",
    "load-test:webhooks": "tsx --env-file=.env.local scripts/load-tests/webhook-throughput.ts",
    "load-test:inbox": "tsx --env-file=.env.local scripts/load-tests/inbox-concurrent-sessions.ts",
    "load-test:ai-replies": "tsx --env-file=.env.local scripts/load-tests/ai-replies-throughput.ts",
    "ai-golden-path": "tsx --env-file=.env.local scripts/ai-golden-path/checklist.ts",
    "setup:stripe": "npx tsx scripts/setup-stripe-webhook.ts",
    "postinstall": "patch-package",
    "voice-stream": "npm run start --workspace=@orzu/voice-stream",
    "dev:voice-stream": "npm run dev --workspace=@orzu/voice-stream",
    "telegram-userbot": "npm run start --workspace=@orzu/telegram-userbot",
    "dev:telegram-userbot": "npm run dev --workspace=@orzu/telegram-userbot",
    "whatsapp-web": "npm run start --workspace=@orzu/whatsapp-web",
    "dev:whatsapp-web": "npm run dev --workspace=@orzu/whatsapp-web"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@google/generative-ai": "^0.24.1",
    "@orzu/platform-ai": "*",
    "@orzu/secrets": "*",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-virtual": "^3.14.2",
    "@upstash/qstash": "^2.11.0",
    "@upstash/redis": "^1.38.0",
    "360dialog-connect-button": "^0.9.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.42.2",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "next": "^15.5.23",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.8.3",
    "sharp": "^0.35.1",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "telegram": "^2.26.22",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.0.2",
    "unpdf": "^1.6.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "^1.3.0",
    "@img/sharp-linux-x64": "^0.35.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "postcss": "^8.5.6",
    "sharp": "^0.35.1",
    "uuid": "^11.1.1"
  }
}
